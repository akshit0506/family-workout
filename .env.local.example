# Copy to .env.local. Read by the app (lib/supabase/*, src/proxy.ts). See
# SUPABASE_SETUP.md for local dev and DEPLOYMENT.md for production values.
#
# No service-role key needed: sign-up/claiming is self-serve (see
# FRONTEND_INTEGRATION.md's "Self-Serve Profile Claiming" milestone) — there's
# no admin script that creates accounts anymore.

# Studio → Project Settings → API. For local dev, `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
